NUVEMSHOP_STORE_ID=
NUVEMSHOP_ACCESS_TOKEN=
NUVEMSHOP_USER_AGENT=Bloqueio CPF (seu-email@dominio.com)
NUVEMSHOP_APP_SECRET=segredo-da-aplicacao-nuvemshop

# Segredos independentes. Gere um valor diferente para cada um.
FLASK_SECRET_KEY=gere-uma-chave-longa-e-aleatoria
CHECKOUT_TOKEN_SECRET=gere-um-segredo-longo-e-independente
CHECKOUT_TOKEN_TTL_SECONDS=300

# Deriva as URLs servidor-servidor não administrativas (webhooks e health).
# Mínimo técnico: 32 caracteres. Recomendado: token_urlsafe(48).
PRIVATE_ROUTE_SECRET=gere-um-segredo-exclusivo-para-as-rotas-privadas

# O admin permanece legível e protegido por Basic Auth + CSRF + rate limit.
ADMIN_USER=admin
ADMIN_PASSWORD=use-uma-senha-longa-e-unica
ADMIN_PATH=/admin

CORS_ORIGINS=https://sua-loja.com.br,https://www.sua-loja.com.br,https://sua-loja.lojavirtualnuvem.com.br,https://checkout.nuvemshop.com.br
RATELIMIT_STORAGE_URI=memory://

LGPD_RETENCAO_DIAS=180
DATABASE_PATH=/var/data/compras.db

CANCELAMENTO_REAL_ATIVO=false
CANCELAMENTO_NOTIFICAR_CLIENTE=true
CANCELAMENTO_REPOR_ESTOQUE=true
MODO_AUTOMATICO=false
